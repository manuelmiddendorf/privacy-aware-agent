{
  "name": "privacy-aware-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A conservative, policy-bound reference agent with a privacy gate before model access.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "test:adapter": "npm run build && node --test dist/tests/transportProvider.test.js",
    "eval": "npm run build && node dist/src/eval.js",
    "demo": "npm run build && node dist/src/demo.js",
    "ui:local": "npm run build && node dist/src/localUiServer.js",
    "test:ui": "npm run build && node --test dist/tests/localUiServer.test.js",
    "test:openai": "npm run build && node --test dist/tests/openaiTransport.test.js",
    "demo:openai": "npm run build && node dist/src/openaiLiveDemo.js",
    "eval:practical": "npm run build && node dist/src/practicalEval.js",
    "demo:openai:practical": "npm run build && node dist/src/openaiPracticalLive.js"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.7.0"
  }
}
